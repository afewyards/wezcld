#!/bin/sh
# it2 - iTerm2 CLI shim for wezcld
# Logs all invocations and translates supported commands into `wezterm cli` calls

set -eu

# Determine state directory. State holds the call log and grid bookkeeping, both
# of which can contain command text, so keep it private to the user.
STATE_DIR="${WEZCLD_STATE:-$HOME/.local/state/wezcld}"
umask 077
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

LOG_FILE="$STATE_DIR/it2-calls.log"
LOG_MAX_BYTES="${WEZCLD_LOG_MAX_BYTES:-1048576}"

# Grid state is keyed by the session leader's pane. wezcld exports
# WEZCLD_LEADER_PANE so every it2 call in the leader's process tree shares one
# grid no matter which pane the caller itself lives in. It stays empty when
# neither variable is set: guessing a pane here would mean splitting and killing
# panes in some unrelated WezTerm window, so the grid commands refuse instead.
LEADER_PANE="${WEZCLD_LEADER_PANE:-${WEZTERM_PANE:-}}"
GRID_FILE=""
LOCK_FILE=""
REAP_FILE=""
if [ -n "$LEADER_PANE" ]; then
    GRID_FILE="$STATE_DIR/grid-panes-$LEADER_PANE"
    LOCK_FILE="$GRID_FILE.lock"
    REAP_FILE="$GRID_FILE.reap"
fi

MAX_COLS=3

# `sleep` with a fractional argument is not POSIX. Probe for it once, lazily, so
# the common commands never pay for the probe, and size the retry budget to
# match: either way waiting tops out at roughly six seconds.
NAP_READY=""
NAP_SECONDS=1
NAP_MAX=6
nap_init() {
    [ -n "$NAP_READY" ] || {
        NAP_READY=1
        if sleep 0.05 2>/dev/null; then
            NAP_SECONDS=0.05
            NAP_MAX=120
        fi
    }
}
nap() { sleep "$NAP_SECONDS" 2>/dev/null || true; }

require_leader_pane() {
    [ -n "$LEADER_PANE" ] && return 0
    echo "it2: no pane to work in (WEZTERM_PANE and WEZCLD_LEADER_PANE are unset)" >&2
    return 1
}

# --- Locking ---------------------------------------------------------------

LOCK_HELD=""

# Create $1 holding our pid, failing if it already exists. `set -C` makes the
# redirection an exclusive create, so taking the lock and publishing the pid are
# one atomic step — with a lock directory plus a separate pid file, a holder
# killed between the two leaves a lock nothing can ever prove stale. `echo` is a
# builtin, which matters: this is spun on, and forking `ln` or `mkdir` per
# attempt would cost far more than the critical section being waited for.
# The `2>/dev/null` has to come first: redirections are applied left to right,
# and the shell reports a failed one on whatever stderr is current at the time.
claim_file() {
    set -C
    if echo "$$" 2>/dev/null > "$1"; then
        set +C
        return 0
    fi
    set +C
    return 1
}

# Clear a lock whose holder is gone. Serialised through a second lock file so
# two waiters cannot both decide to clear the same stale lock and have the loser
# go on to delete the lock the winner has meanwhile taken for itself.
reclaim_stale_lock() {
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null) || return 0
    [ -n "$lock_pid" ] || return 0
    kill -0 "$lock_pid" 2>/dev/null && return 0

    reap_pid=$(cat "$REAP_FILE" 2>/dev/null || echo "")
    if [ -n "$reap_pid" ] && ! kill -0 "$reap_pid" 2>/dev/null; then
        rm -f "$REAP_FILE"   # a reaper died inside its own critical section
    fi
    claim_file "$REAP_FILE" || return 0

    # Re-read while holding the reaper lock: between the check above and here the
    # dead holder's lock may already have been cleared and taken by a live one.
    now_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [ "$now_pid" = "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
        rm -f "$LOCK_FILE"
    fi
    rm -f "$REAP_FILE"
}

# Spin briefly, then wait. Sleeping 0.2s after every attempt with only five
# attempts starved waiters badly — with several teammates closing panes at once
# most of them ran out of retries and skipped their grid update — but spinning
# the whole time is just as bad, since the CPU burnt is what the holder needs to
# finish. So: a short spin for the common case, then yield on a bounded budget.
grid_lock() {
    [ -n "$LOCK_FILE" ] || return 1

    spins=0
    while [ "$spins" -lt 30 ]; do
        claim_file "$LOCK_FILE" && { LOCK_HELD=1; return 0; }
        spins=$((spins + 1))
    done

    nap_init
    waits=0
    while [ "$waits" -lt "$NAP_MAX" ]; do
        reclaim_stale_lock
        nap
        claim_file "$LOCK_FILE" && { LOCK_HELD=1; return 0; }
        waits=$((waits + 1))
    done
    return 1
}

grid_unlock() {
    LOCK_HELD=""
    rm -f "$LOCK_FILE"
}

# Release the lock on every exit path, including `set -e` aborts and signals.
cleanup() {
    [ -n "$LOCK_HELD" ] && grid_unlock
    return 0
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# --- Helpers ---------------------------------------------------------------

# Quote a string so the receiving shell reads it back as one literal argument,
# whatever it contains. Tokens made only of characters no shell reinterprets are
# passed through untouched — the command is typed into a visible pane and lands
# in its history, so it should stay readable.
shquote() {
    case "$1" in
        '')
            printf "''"
            ;;
        *[!A-Za-z0-9_@%+=:,./-]*)
            printf "'"
            printf '%s' "$1" | sed "s/'/'\\\\''/g"
            printf "'"
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

# Logging happens after the work is done, so nothing in here may fail the
# command: concurrent shims race on the same file, and a lost log line is not
# worth reporting a send that actually succeeded as an error.
rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    size=$(wc -c < "$LOG_FILE" 2>/dev/null | tr -d ' ') || return 0
    [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] 2>/dev/null || return 0
    mv "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || true
}

# Log invocation with ISO timestamp
log_call() {
    exit_code="$1"
    shift
    output="$*"
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    rotate_log
    printf '[%s] ARGV: %s | EXIT: %d | STDOUT: %s\n' \
        "$timestamp" "$ARGV_STR" "$exit_code" "$output" >> "$LOG_FILE" 2>/dev/null || true
}

# Remove pane IDs from the grid file that no longer exist in WezTerm
prune_stale_panes() {
    [ -s "$GRID_FILE" ] || return 0

    # Ask for JSON instead of parsing the human-readable table by column
    # position — the table layout is not a stable interface.
    live_json=$(wezterm cli list --format json 2>/dev/null) || return 0
    if command -v jq >/dev/null 2>&1; then
        live_panes=$(printf '%s' "$live_json" | jq -r '.[].pane_id' 2>/dev/null)
    else
        # No jq: split on commas and match only a fragment that *starts* with
        # the key. Pane titles are content-controlled and can contain the text
        # `"pane_id": 7`, but inside a JSON string its quotes arrive escaped, so
        # such a fragment can never begin with a bare `"pane_id":` — an
        # unanchored match here would let a title forge a live pane id and keep
        # dead entries in the grid forever.
        live_panes=$(printf '%s' "$live_json" | tr ',' '\n' | tr -d ' \t' |
            sed -n 's/^"pane_id":\([0-9][0-9]*\)$/\1/p')
    fi
    # Refuse to prune on an unrecognised response rather than dropping the grid.
    [ -n "$live_panes" ] || return 0

    tmp="$GRID_FILE.prune.$$"
    : > "$tmp"
    while IFS= read -r pane_id; do
        [ -n "$pane_id" ] || continue
        if printf '%s\n' "$live_panes" | grep -qx "$pane_id"; then
            printf '%s\n' "$pane_id" >> "$tmp"
        fi
    done < "$GRID_FILE"
    mv "$tmp" "$GRID_FILE"
}

# --- Commands --------------------------------------------------------------
# Each command runs in the current shell (never a command substitution) so that
# the lock bookkeeping, the EXIT trap and `exit` all act on the real process. It
# reports what it printed by assigning to `output`, which main() then logs.

# Create a pane in the next free grid slot. `-s <parent>` is accepted for
# compatibility but ignored: placement is decided by the grid, not the caller.
do_split() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--session)
                shift
                if [ $# -gt 0 ]; then shift; fi
                ;;
            *)
                shift
                ;;
        esac
    done

    require_leader_pane || exit 1
    grid_lock || { echo "Failed to acquire grid lock" >&2; exit 1; }

    # Prune stale panes before calculating positions
    prune_stale_panes

    # Count existing panes
    agent_count=0
    if [ -f "$GRID_FILE" ]; then
        agent_count=$(wc -l < "$GRID_FILE" 2>/dev/null | tr -d ' ')
    fi

    # Calculate grid position
    row=$((agent_count / MAX_COLS))
    col=$((agent_count % MAX_COLS))

    # Determine split direction and target pane
    new_pane_id=""
    if [ "$row" -eq 0 ] && [ "$col" -eq 0 ]; then
        # First agent: split from leader (top)
        new_pane_id=$(wezterm cli split-pane --top --percent 65 --pane-id "$LEADER_PANE") || true
    elif [ "$row" -eq 0 ]; then
        # Filling first row: split right from previous pane
        previous_pane=$(tail -n 1 "$GRID_FILE")
        # Calculate percent so all columns end up equal width
        remaining=$((MAX_COLS - col))
        pct=$(( (100 * remaining + (remaining + 1) / 2) / (remaining + 1) ))
        new_pane_id=$(wezterm cli split-pane --right --percent "$pct" --pane-id "$previous_pane") || true
    else
        # New row: split bottom from pane above (same column)
        pane_above_index=$((agent_count - MAX_COLS + 1))
        pane_above=$(sed -n "${pane_above_index}p" "$GRID_FILE")
        new_pane_id=$(wezterm cli split-pane --bottom --pane-id "$pane_above") || true
    fi

    if [ -z "$new_pane_id" ]; then
        echo "Failed to create split pane" >&2
        exit 1
    fi

    # Append to grid-panes file
    echo "$new_pane_id" >> "$GRID_FILE"

    grid_unlock

    # Refocus leader pane
    wezterm cli activate-pane --pane-id "$LEADER_PANE" 2>/dev/null || true

    output="Created new pane: $new_pane_id"
    echo "$output"
}

# Type a command into a target pane. Argument quoting has to survive the trip:
# the text is handed to an interactive shell, which re-parses it.
do_run() {
    target=""
    raw=""

    # Options precede the command, and parsing stops at the first non-option.
    # Scanning the whole argument list instead would let a `-s` belonging to the
    # command be taken as ours: `session run -s 5 claude --session abc` would
    # target pane `abc`, and `session run -s 5 sort -s -k1` would send a bare
    # `sort` to a pane called `-k1`. `--` forces the command to start even when
    # it begins with something option-shaped.
    while [ $# -gt 0 ]; do
        case "$1" in
            --)
                shift
                break
                ;;
            -s|--session)
                shift
                if [ $# -gt 0 ]; then target="$1"; shift; fi
                ;;
            --raw)
                raw=1
                shift
                ;;
            -*)
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    [ -n "$target" ] || return 0
    [ $# -gt 0 ] || return 0

    if [ $# -eq 1 ]; then
        # One argument is a whole command line by contract, so it goes as-is —
        # re-quoting it would turn `echo hi` into the name of a missing command.
        cmd="$1"
    elif [ -n "$raw" ]; then
        # `--raw` extends that to several arguments, for callers that assemble a
        # command line out of pieces and want operators like `&&` to stay live.
        # Joined explicitly rather than with "$*", which would follow an
        # inherited IFS.
        cmd="$1"
        shift
        for arg in "$@"; do
            cmd="$cmd $arg"
        done
    else
        # Several arguments are an argv: quote each one so the receiving shell
        # sees exactly the words the caller passed.
        cmd=""
        for arg in "$@"; do
            if [ -z "$cmd" ]; then
                cmd=$(shquote "$arg")
            else
                cmd="$cmd $(shquote "$arg")"
            fi
        done
    fi

    printf '%s\n' "$cmd" | wezterm cli send-text --no-paste --pane-id "$target"
}

do_close() {
    target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--session)
                shift
                if [ $# -gt 0 ]; then target="$1"; shift; fi
                ;;
            *)
                shift
                ;;
        esac
    done

    if [ -n "$target" ]; then
        wezterm cli kill-pane --pane-id "$target" 2>/dev/null || true
        # Remove from grid-panes (under lock)
        if [ -n "$LOCK_FILE" ]; then
            if grid_lock; then
                if [ -f "$GRID_FILE" ]; then
                    tmp="$GRID_FILE.tmp.$$"
                    grep -v "^${target}$" "$GRID_FILE" > "$tmp" 2>/dev/null || true
                    mv "$tmp" "$GRID_FILE"
                fi
                grid_unlock
            else
                # Say so rather than dropping the update on the floor: a stale id
                # left in the grid misplaces every later split.
                echo "it2: could not lock grid state; pane $target left in $GRID_FILE" >&2
            fi
        fi
    fi

    output="Session closed"
    echo "$output"
}

# --- Entry point -----------------------------------------------------------

# Store original arguments for logging
ARGV_STR="it2"
for arg in "$@"; do
    # Sanitize: replace newlines with spaces, wrap args with special chars in single quotes
    sanitized=$(printf '%s' "$arg" | tr '\n\r' '  ')
    case "$sanitized" in
        *[\ \"\|]*) ARGV_STR="$ARGV_STR '${sanitized}'" ;;
        *) ARGV_STR="$ARGV_STR $sanitized" ;;
    esac
done

# Dispatch based on arguments. The short forms (`it2 split`) and the long forms
# (`it2 session split`) run the same implementation — they used to diverge, with
# the short forms handing back invented session IDs that no later call could use.
main() {
    exit_code=0
    output=""

    # Fold "session split" into a single verb so the long and short forms can
    # share a case arm. `shift` is guarded: dash treats an over-long shift as a
    # fatal error, so it must never be asked to shift past the end.
    verb="${1:-}"
    case "$verb" in
        session|app)
            if [ $# -ge 2 ]; then
                verb="$1 $2"
                shift 2
            else
                shift
            fi
            ;;
        *)
            if [ $# -gt 0 ]; then shift; fi
            ;;
    esac

    case "$verb" in
        --version|"app version")
            output="it2 0.2.3"
            echo "$output"
            ;;
        --help|"")
            output="it2 - iTerm2 CLI (wezcld shim)"
            echo "$output"
            ;;
        split|vsplit|"session split")
            do_split "$@"
            ;;
        run|"session run")
            do_run "$@"
            ;;
        close|"session close")
            do_close "$@"
            ;;
        ls|"session list")
            output="Session ID       Name    Title           Size    TTY"
            echo "$output"
            ;;
        *)
            # Everything else is a silent success: unimplemented iTerm2 verbs
            # must not look like failures to Claude Code.
            output=""
            ;;
    esac

    log_call "$exit_code" "$output"
    return "$exit_code"
}

main "$@"
